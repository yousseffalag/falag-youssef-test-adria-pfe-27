enum TransactionType {
    DEBIT
    CREDIT
}

type Transaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
    type: TransactionType!
    transferId: ID
    createdAt: String!
}

type Transfer {
    transferId: ID!
    debit: Transaction!
    credit: Transaction!
}

input CreateTransactionInput {
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
}

input TransferInput {
    sourceAccountId: ID!
    targetAccountId: ID!
    amount: Float!
    currency: String!
}

type Query {
    transactionsByAccount(accountId: ID!): [Transaction!]!
    transactionById(id: ID!): Transaction
}

type Mutation {
    createTransaction(input: CreateTransactionInput!): Transaction!
    createTransfer(input: TransferInput!): Transfer!
}
